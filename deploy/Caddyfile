# Caddy 配置模板 —— 复制到服务器 /etc/caddy/Caddyfile
# 把 docs.example.com 替换为你的真实域名，然后 `sudo systemctl reload caddy`

docs.example.com {
    root * /var/www/mcp-docs

    # 压缩
    encode zstd gzip

    # 干净 URL：优先精确路径，其次目录 index，其次 .html，最后 404
    try_files {path} {path}/ {path}.html /404.html
    file_server

    # 可选：静态资源长缓存（图片/JS/CSS）
    @assets {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2
    }
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # 自定义 404
    handle_errors {
        @404 expression {http.error.status_code} == 404
        rewrite @404 /404.html
        file_server
    }
}
